<script is:inline>
  // Toggle between dark (default) and light. Persist in localStorage.
  (function () {
    const STORAGE_KEY = "theme";
    function apply(theme) {
      const html = document.documentElement;
      if (theme === "light") {
        html.classList.add("light");
      } else {
        html.classList.remove("light");
      }
    }

    function onClick() {
      const next = document.documentElement.classList.contains("light")
        ? "dark"
        : "light";
      try {
        localStorage.setItem(STORAGE_KEY, next);
      } catch (e) {}
      apply(next);
    }

    document.addEventListener("astro:page-load", function () {
      const btn = document.getElementById("theme-toggle");
      if (!btn) return;
      btn.addEventListener("click", onClick);
    });
  })();
</script>

<button
  id="theme-toggle"
  type="button"
  class="rounded-md p-2 text-muted-fg hover:text-foreground transition-colors focus:outline-none"
  aria-label="Toggle theme"
  title="Toggle light / dark"
>
  <!-- Sun (shown when in light mode = click to go dark) -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="h-5 w-5 hidden dark-show"
  >
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
  <!-- Moon (shown when in dark mode = click to go light) -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="h-5 w-5 light-show"
  >
    <path d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
  </svg>
</button>

<style>
  /* In dark mode (default), show the moon. In .light, show the sun. */
  :global(html:not(.light)) .light-show {
    display: block;
  }
  :global(html:not(.light)) .dark-show {
    display: none;
  }
  :global(html.light) .light-show {
    display: none;
  }
  :global(html.light) .dark-show {
    display: block;
  }
</style>
