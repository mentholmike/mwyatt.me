---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../consts";
---

<Layout title={`404 — ${SITE.title}`} description="Page not found.">
  <section class="py-16 text-center">
    <h1 class="text-7xl font-bold text-accent">404</h1>
    <p class="mt-3 text-xl text-muted-fg">Page not found.</p>
    <p class="mt-2 text-sm text-muted-fg">¯\_(ツ)_/¯</p>
    <a
      href="/"
      class="mt-6 inline-block text-accent hover:text-hover"
    >
      &larr; Back home
    </a>
  </section>
</Layout>
